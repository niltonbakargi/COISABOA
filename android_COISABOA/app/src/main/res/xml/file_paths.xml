<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Caminho para armazenamento externo público (Downloads) -->
    <external-path name="external_downloads" path="Download/" />
    <external-path name="external_downloads_coisaboa" path="Download/COISABOA/" />
    
    <!-- Caminho para arquivos externos privados do app -->
    <external-files-path name="external_files_backup" path="backup/" />
    <external-files-path name="external_files" path="." />
    
    <!-- Caminho para arquivos internos privados do app -->
    <files-path name="internal_files_backup" path="backup/" />
    <files-path name="internal_files" path="." />
    
    <!-- Caminho para cache -->
    <cache-path name="cache" path="." />
    
    <!-- Caminho para arquivos externos (Android 4.4+) -->
    <external-files-path name="external_storage" path="." />
</paths>