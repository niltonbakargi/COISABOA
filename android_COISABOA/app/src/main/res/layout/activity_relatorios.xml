<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Relatórios do Sistema"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="16dp"
            android:textColor="#2C3E50" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Resumo geral:"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#37474F"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/tvResumo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Total de vendas: 0\n• Itens em estoque: 0\n• Lucro estimado: R$ 0,00"
            android:textSize="15sp"
            android:textColor="#444"
            android:paddingBottom="24dp" />

        <Button
            android:id="@+id/btnGerarRelatorio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gerar Relatório Financeiro"
            android:backgroundTint="#6366F1"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnRelatorioVendas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Relatório de Vendas"
            android:backgroundTint="#F59E0B"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnRelatorioEstoque"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Relatório de Estoque"
            android:backgroundTint="#10B981"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnVoltar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Voltar"
            android:backgroundTint="#9CA3AF"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</ScrollView>
