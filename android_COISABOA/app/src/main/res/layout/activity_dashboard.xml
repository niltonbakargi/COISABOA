<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Painel de Controle"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#2C3E50"
            android:gravity="center"
            android:paddingBottom="24dp" />

        <Button
            android:id="@+id/btnComprar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Comprar"
            android:backgroundTint="#43A047"
            android:textColor="#FFF"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnVender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vender"
            android:backgroundTint="#FB8C00"
            android:textColor="#FFF"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnGerenciar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gerenciar Estoque"
            android:backgroundTint="#1976D2"
            android:textColor="#FFF"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnRelatorios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Relatórios"
            android:backgroundTint="#6A1B9A"
            android:textColor="#FFF"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnBackup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fazer Backup"
            android:backgroundTint="#0288D1"
            android:textColor="#FFF"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnSair"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sair do Sistema"
            android:backgroundTint="#E53935"
            android:textColor="#FFF" />

    </LinearLayout>
</ScrollView>
