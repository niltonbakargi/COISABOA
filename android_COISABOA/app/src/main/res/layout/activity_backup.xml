<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#f5f5f5">

    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Backup de Dados"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#ffffff"
        android:padding="16dp"
        android:layout_marginBottom="24dp"
        android:elevation="2dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status do Sistema"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvBackupInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Carregando status..."
            android:textSize="14sp"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#ffffff"
        android:padding="16dp"
        android:layout_marginBottom="24dp"
        android:elevation="2dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Acoes"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvBackupStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pronto para backup"
            android:textSize="14sp"
            android:textColor="#666666"
            android:gravity="center"
            android:layout_marginBottom="16dp"
            android:padding="8dp"
            android:background="#e8f5e8" />

        <Button
            android:id="@+id/btnFazerBackup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fazer Backup Agora"
            android:textSize="16sp"
            android:background="#4CAF50"
            android:textColor="#ffffff"
            android:layout_marginBottom="12dp"
            android:padding="12dp" />

        <Button
            android:id="@+id/btnRestaurarBackup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Restaurar Backup"
            android:textSize="16sp"
            android:background="#2196F3"
            android:textColor="#ffffff"
            android:layout_marginBottom="12dp"
            android:padding="12dp" />

        <!-- NOVOS BOTÕES -->
        <Button
            android:id="@+id/btnSalvarBackup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💾 Salvar Backup no Aparelho"
            android:textSize="16sp"
            android:background="#FF9800"
            android:textColor="#ffffff"
            android:layout_marginBottom="12dp"
            android:padding="12dp" />

        <Button
            android:id="@+id/btnCompartilharBackup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="☁️ Compartilhar Backup"
            android:textSize="16sp"
            android:background="#9C27B0"
            android:textColor="#ffffff"
            android:layout_marginBottom="12dp"
            android:padding="12dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#ffffff"
        android:padding="16dp"
        android:elevation="2dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Informacoes"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Backup salvo em: Documents/COISABOA/"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sao mantidas 2 versoes de backup"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dados incluidos: Produtos e Vendas"
            android:textSize="14sp" />

    </LinearLayout>

    <Button
        android:id="@+id/btnVoltarBackup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Voltar"
        android:layout_gravity="start"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="24dp" />

</LinearLayout>