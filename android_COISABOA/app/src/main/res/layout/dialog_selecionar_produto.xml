<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFF">

    <!--  Campo de busca -->
    <EditText
        android:id="@+id/etBuscarProduto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Buscar produto..."
        android:inputType="text"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawablePadding="8dp"
        android:padding="10dp"
        android:backgroundTint="#9CA3AF"
        android:textColor="#000000"
        android:layout_marginBottom="10dp" />

    <!--  Lista de produtos -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvListaProdutos"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:scrollbars="vertical"
        android:background="#F3F4F6"
        android:padding="4dp"
        android:clipToPadding="false" />

    <!--  Mensagem quando nenhum produto for encontrado -->
    <TextView
        android:id="@+id/tvSemResultados"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nenhum produto encontrado"
        android:textColor="#6B7280"
        android:textStyle="italic"
        android:gravity="center"
        android:visibility="gone"
        android:paddingTop="12dp"
        android:paddingBottom="6dp"
        android:textSize="14sp" />

</LinearLayout>

