<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/itemProdutoCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="10dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_produto"
    android:elevation="3dp"
    android:clickable="true"
    android:focusable="true">

    <!-- 🖼️ Imagem do produto -->
    <ImageView
        android:id="@+id/imgThumb"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="10dp"
        android:background="#E2E8F0"
        android:scaleType="centerCrop"
        android:contentDescription="Imagem do produto"
        android:elevation="1dp" />

    <!-- 📋 Informações -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <!-- Nome do produto -->
        <TextView
            android:id="@+id/tvNome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nome do Produto"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:textSize="16sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginBottom="4dp" />

        <!-- Quantidade -->
        <TextView
            android:id="@+id/tvQtd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Qtd: 0"
            android:textColor="#475569"
            android:textSize="14sp"
            android:layout_marginBottom="2dp" />

        <!-- Valores -->
        <TextView
            android:id="@+id/tvValores"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Custo: R$ 0,00 | Revenda: R$ 0,00"
            android:textColor="#64748B"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- ✏️ Botão de ação -->
    <ImageView
        android:id="@+id/btnEditar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center_vertical"
        android:padding="8dp"
        android:src="@android:drawable/ic_menu_edit"
        android:tint="#0284C7"
        android:contentDescription="Editar produto"
        android:focusable="false"
        android:clickable="true" />

</LinearLayout>
