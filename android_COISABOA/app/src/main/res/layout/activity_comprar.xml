<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nova Compra"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp" />

        <!-- Nome do Produto -->
        <EditText
            android:id="@+id/etProduto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nome do Produto"
            android:inputType="text" />

        <!-- Quantidade -->
        <EditText
            android:id="@+id/etQuantidade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Quantidade"
            android:inputType="number"
            android:layout_marginTop="12dp" />

        <!-- Valor Unitário -->
        <EditText
            android:id="@+id/etValorUnitario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Valor Unitário (R$)"
            android:inputType="numberDecimal"
            android:layout_marginTop="12dp" />

        <!-- Valor Revenda -->
        <EditText
            android:id="@+id/etValorRevenda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Valor de Revenda (R$)"
            android:inputType="numberDecimal"
            android:layout_marginTop="12dp" />

        <!-- Valor Total -->
        <TextView
            android:id="@+id/tvValorTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="R$ 0,00"
            android:textAlignment="center"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <!-- Forma de Pagamento -->
        <Spinner
            android:id="@+id/spPagamento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <!-- Captura de Imagens -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="20dp">

            <Button
                android:id="@+id/btnFotoProduto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📸 Produto"
                android:backgroundTint="#1976D2"
                android:textColor="@android:color/white"
                android:layout_marginEnd="12dp" />

            <Button
                android:id="@+id/btnFotoNota"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧾 Nota"
                android:backgroundTint="#009688"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <!-- Preview das fotos -->
        <ImageView
            android:id="@+id/imgPreviewProduto"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:layout_marginTop="16dp"
            android:background="#E0E0E0" />

        <ImageView
            android:id="@+id/imgPreviewNota"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:layout_marginTop="12dp"
            android:background="#E0E0E0" />

        <!-- Botão Salvar -->
        <Button
            android:id="@+id/btnSalvarCompra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Salvar Compra"
            android:textColor="@android:color/white"
            android:backgroundTint="#4CAF50"
            android:layout_marginTop="24dp"
            android:padding="12dp" />
    </LinearLayout>
</ScrollView>
