<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!--  Ttulo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nova Compra"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#2C3E50"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp" />

        <!--  Campos de entrada -->
        <EditText
            android:id="@+id/etProduto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nome do Produto"
            android:inputType="text" />

        <EditText
            android:id="@+id/etQuantidade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Quantidade"
            android:inputType="number"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/etValorUnitario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Valor Unitrio (R$)"
            android:inputType="numberDecimal"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/etValorRevenda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Valor de Revenda (R$)"
            android:inputType="numberDecimal"
            android:layout_marginTop="12dp" />

        <!--  Valor total -->
        <TextView
            android:id="@+id/tvValorTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="R$ 0,00"
            android:textAlignment="center"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#388E3C"
            android:layout_marginTop="16dp" />

        <!--  Forma de pagamento -->
        <Spinner
            android:id="@+id/spPagamento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <!--  Botes para tirar fotos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="20dp">

            <Button
                android:id="@+id/btnFotoProduto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" Produto"
                android:backgroundTint="#1976D2"
                android:textColor="@android:color/white"
                android:layout_marginEnd="12dp" />

            <Button
                android:id="@+id/btnFotoVendedor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" Vendedor"
                android:backgroundTint="#009688"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <!--  Previews lado a lado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="4dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Foto do Produto"
                    android:textAlignment="center"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="#555"
                    android:layout_marginBottom="4dp" />

                <ImageView
                    android:id="@+id/imgPreviewProduto"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:scaleType="centerCrop"
                    android:background="#E0E0E0"
                    android:contentDescription="Preview do Produto" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="4dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Foto do Vendedor"
                    android:textAlignment="center"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="#555"
                    android:layout_marginBottom="4dp" />

                <ImageView
                    android:id="@+id/imgPreviewVendedor"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:scaleType="centerCrop"
                    android:background="#E0E0E0"
                    android:contentDescription="Preview do Vendedor" />
            </LinearLayout>
        </LinearLayout>

        <!--  Boto salvar -->
        <Button
            android:id="@+id/btnSalvarCompra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=" Salvar Compra"
            android:textColor="@android:color/white"
            android:backgroundTint="#4CAF50"
            android:layout_marginTop="24dp"
            android:padding="12dp"
            android:textAllCaps="false"
            android:elevation="2dp" />
    </LinearLayout>
</ScrollView>

