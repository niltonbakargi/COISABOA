<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.coisaboa.app">

    <!-- 🔒 Permissões básicas -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.COISABOA">

        <!-- 🏠 Tela Inicial (Launcher) -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 🔐 Tela de Login -->
        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 📊 Tela do Dashboard -->
        <activity
            android:name=".ui.dashboard.DashboardActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 🛒 Tela de Compras -->
        <activity
            android:name=".ui.compras.ComprarActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 🏷️ Tela de Vendas -->
        <activity
            android:name=".ui.vendas.VenderActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- ⚙️ Tela de Gerenciamento de Estoque -->
        <activity
            android:name=".ui.gerenciar.GerenciarActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 📈 Tela de Relatórios -->
        <activity
            android:name=".ui.relatorios.RelatoriosActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- ☁️ Tela de Backup -->
        <activity
            android:name=".ui.backup.BackupActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 🧩 Suporte a Room (persistência local) -->
        <meta-data
            android:name="androidx.room.Database"
            android:value="coisaboa.db" />

    </application>

</manifest>
