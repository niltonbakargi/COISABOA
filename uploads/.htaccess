# COISABOA - Configurações de Segurança para Uploads
# Permite acesso apenas a arquivos de mídia

Order Allow,Deny
Allow from all

# Bloquear execução de scripts
<FilesMatch "\.(php|php5|phtml|pl|py|jsp|asp|sh|cgi)$">
    Deny from all
</FilesMatch>

# Permitir apenas tipos de mídia
<FilesMatch "\.(jpg|jpeg|png|gif|webp|ico|pdf|txt)$">
    Allow from all
</FilesMatch>

# Headers de segurança para imagens
<FilesMatch "\.(jpg|jpeg|png|gif|webp)$">
    Header always set X-Content-Type-Options nosniff
    Header always set Content-Security-Policy "default-src 'none'"
    Header always set Cache-Control "public, max-age=2592000" # 30 dias
</FilesMatch>

# Prevenir hotlinking (opcional)
# RewriteEngine On
# RewriteCond %{HTTP_REFERER} !^https?://(www\.)?seusite.com [NC]
# RewriteCond %{HTTP_REFERER} !^$
# RewriteRule \.(jpg|jpeg|png|gif)$ - [F]

ErrorDocument 403 "<h1>Acesso Negado</h1><p>Este tipo de arquivo não pode ser acessado diretamente.</p>"

# Limitar métodos HTTP
<LimitExcept GET POST>
    Deny from all
</LimitExcept>